# Azure OpenAI endpoint and model deployments
AZURE_OPENAI_ENDPOINT=https://ews-foundry-play.openai.azure.com
MODEL_LARGE=gpt-5.4
MODEL_SMALL=gpt-5.4-mini
MODEL_ROUTER=model-router
EMBEDDING_MODEL=text-embedding-3-large
REASONING_EFFORT=low

# common.py currently authenticates with Entra ID via DefaultAzureCredential.
# Set AZURE_OPENAI_API_KEY only if using API-key authentication in a client.
AZURE_OPENAI_API_KEY=

# Optional demo settings
DEMO_NO_PAUSE=0
CALLS_PER_DAY=1000000
OUTPUT_CAP=200
SEMANTIC_THRESHOLD=0.85
# MODEL_BASELINE=gpt-4o
# PROMPT_CACHE_KEY=your-cache-key

# Optional: Demo 7b (Claude on Microsoft Foundry)
ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
